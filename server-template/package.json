{
  "name": "server-template",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "NODE_ENV=production bun build src/index.ts --outdir dist --target bun --minify",
    "start": "NODE_ENV=production bun run src/index.ts",
    "test": "INTERNAL_API_SECRET=test-secret-for-integration-tests bun test src/tests/",
    "db:studio": "drizzle-kit studio",
    "db:indexes": "bun run src/db/setup-indexes.ts",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10"
  }
}
