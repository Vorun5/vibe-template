# Project name — used for docker-compose container/db names
PROJECT_NAME=server-template

# Database (REQUIRED — server will not boot without it)
DATABASE_URL=postgresql://postgres:password@localhost:5432/server_template

# Server
PORT=3000
DATA_ROOT=./data

# Loki / structured logging
# LOKI_APP_NAME is used as: Prometheus default-metrics prefix (<name>_),
# Loki job label, and log stream label. Pick something kebab/snake-friendly.
LOKI_APP_NAME=server-template
LOKI_URL=

# Internal API Security (REQUIRED — server will not boot without it)
# Generate a strong random secret: openssl rand -hex 32
INTERNAL_API_SECRET=change-me-generate-with-openssl-rand-hex-32

# Comma-separated IP whitelist for /internal/* endpoints.
# Default below allows localhost only.
INTERNAL_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# IP Blocklist — seed values (comma-separated IPs or /24 prefixes).
# Full IP: "1.2.3.4" — blocks only that IP
# Prefix: "57.141.20" — blocks all 57.141.20.0/24
# Runtime additions/removals via /internal/blocklist/* are stored in
# ${DATA_ROOT}/blocklist.json (env entries here are read-only seed values).
IP_BLOCKLIST=

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_API=120
RATE_LIMIT_MAX_SEARCH=30
RATE_LIMIT_MAX_COVERS=600
RATE_LIMIT_BAN_THRESHOLD=5
RATE_LIMIT_BAN_DURATION_MS=600000
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
RATE_LIMIT_WHITELIST=
