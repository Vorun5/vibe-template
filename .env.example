# Root .env — picked up automatically by `docker compose up` at this directory.

# Compose project namespace (drives container_name prefixes).
PROJECT_NAME=template

# REQUIRED — Grafana admin password (compose refuses to boot if empty).
GF_SECURITY_ADMIN_PASSWORD=change-me-please

# REQUIRED — Postgres superuser password (compose refuses to boot if empty).
# Generate: `openssl rand -hex 32`
POSTGRES_PASSWORD=change-me-please

# REQUIRED — Shared secret for service-to-service /internal/* auth.
# Compose AND the server itself refuse to boot if empty or set to a well-known
# default (e.g. "change-me-in-prod", "password"). Generate: `openssl rand -hex 32`
INTERNAL_API_SECRET=change-me-please

# Optional — comma-separated IPs allowed to reach /internal/*. Defaults to
# loopback only. Add reverse-proxy / sidecar container IPs here when you
# expose /internal/* across the compose network.
# INTERNAL_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# Optional host port overrides (only useful when something else already
# uses the default port locally).
GRAFANA_HOST_PORT=3001
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
NODE_EXPORTER_HOST_PORT=9100
POSTGRES_EXPORTER_HOST_PORT=9187

# Retention.
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB
