      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_hit{datname=\"freebusta\"}[5m])",
          "legendFormat": "Cache Hits",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_blks_read{datname=\"freebusta\"}[5m])",
          "legendFormat": "Disk Reads",
          "refId": "B"
