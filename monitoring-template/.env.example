# ---------- Required ----------

# Compose project namespace — used as the prefix of every container name
# (${PROJECT_NAME}-prometheus, ${PROJECT_NAME}-grafana, ...) AND as the
# Grafana dashboards folder.
PROJECT_NAME=monitoring

# Logical name of YOUR application. The Prometheus docker_sd job matches
# container names against /<APP_NAME>-.*/ to discover scrape targets.
APP_NAME=myapp

# Port your app exposes /metrics on (inside the container).
APP_METRICS_PORT=3000

# Grafana admin password. Server refuses to boot if empty.
GF_SECURITY_ADMIN_PASSWORD=change-me-please

# ---------- Optional ----------

# Postgres exporter DSN. Leave empty AND remove the postgres-exporter
# service from docker-compose.yml if you don't have a database.
# Example: postgresql://user:pass@db-host:5432/mydb?sslmode=disable
POSTGRES_EXPORTER_DSN=

# Loki retention. Default = 7 days. Bump to 720h (30d) if you have disk.
LOKI_RETENTION_HOURS=168h

# Prometheus retention.
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB

# Host port mappings. Override if you have conflicts.
GRAFANA_HOST_PORT=3001
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
NODE_EXPORTER_HOST_PORT=9100
POSTGRES_EXPORTER_HOST_PORT=9187

# External Docker network (Dokploy / Swarm). Leave commented for plain
# docker-compose. When set, all services join it AND prometheus / promtail
# match docker_sd targets only within that network.
# EXTERNAL_NETWORK_NAME=dokploy-network
