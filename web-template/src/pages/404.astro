---
import Layout from "@/layouts/Layout.astro";

const SITE_NAME = import.meta.env.PUBLIC_SITE_NAME || "Web Template";
---

<Layout title={`Page not found — ${SITE_NAME}`} noindex={true}>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <span
      class="mb-6 flex items-center justify-center w-20 h-20 rounded-full bg-primary text-white text-lg font-bold"
    >
      404
    </span>

    <h1 class="text-2xl font-bold text-text-base mb-3">Page not found</h1>
    <p class="text-text-base-muted max-w-sm mb-10 text-md">
      The page you're looking for doesn't exist, or has been moved.
    </p>

    <a href="/" class="no-underline">
      <span
        class="block bg-primary text-white! px-4 py-2 text-lg font-medium rounded-[1px] hover:rounded-xl transition-[border-radius] duration-150"
        >Back home</span
      >
    </a>
  </div>
</Layout>
