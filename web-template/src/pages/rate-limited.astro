---
import Layout from "@/layouts/Layout.astro";

const SITE_NAME = import.meta.env.PUBLIC_SITE_NAME || "Web Template";
const retryAfter = Number(Astro.url.searchParams.get("retry")) || 60;
---

<Layout title={`Too many requests — ${SITE_NAME}`} noindex={true}>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <span
      class="mb-6 flex items-center justify-center w-20 h-20 rounded-full bg-primary text-white text-lg font-bold"
    >
      429
    </span>

    <h1 class="text-2xl font-bold text-text-base mb-3">Too many requests</h1>
    <p class="text-text-base-muted max-w-sm mb-2 text-md">
      We're seeing unusually high traffic from your IP.
    </p>
    <p class="text-text-base-muted max-w-sm mb-4 text-md">
      If you're using a <strong>VPN</strong> or a shared network, try disabling the
      VPN and refreshing.
    </p>
    <p class="text-text-base-muted text-sm mb-6">
      Try again in {retryAfter} seconds.
    </p>

    <a href="/" class="no-underline">
      <span
        class="block bg-primary text-white! px-4 py-2 text-lg font-medium rounded-[1px] hover:rounded-xl transition-[border-radius] duration-150"
        >Back home</span
      >
    </a>
  </div>
</Layout>
