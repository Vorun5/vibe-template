# API URLs
# API_URL — used during SSR (server-side fetch from frontmatter)
# PUBLIC_API_URL — used by React islands in the browser
API_URL=http://localhost:3000
API_VERSION=v1
PUBLIC_API_URL=http://localhost:3000
PUBLIC_API_VERSION=v1

# Static CDN / asset host (referenced by CSP connect-src so islands can fetch it)
PUBLIC_STATIC_URL=http://localhost:3000

# Canonical site origin — drives canonical URLs, OG tags, JSON-LD
PUBLIC_SITE_URL=http://localhost:4321

# Site identity — used as Layout title default, og:site_name, JSON-LD name
PUBLIC_SITE_NAME=Web Template
PUBLIC_SITE_DESCRIPTION=A starter Astro SSR application.
PUBLIC_OG_IMAGE=/og-default.png

# Google Analytics (optional). Set to a measurement ID like "G-XXXXXXXXXX"
# to enable the gtag block in Layout.astro. Leave empty to skip GA entirely.
PUBLIC_GA_ID=

# Logging
LOKI_URL=
LOKI_APP_NAME=web

# Trusted Proxies (SECURITY: IPs allowed to set X-Forwarded-For header)
# Default: localhost only. In production, add your reverse proxy IPs.
TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1

# Frontend Rate Limiting (protects SSR rendering layer)
RATE_LIMIT_WEB_ENABLED=false
RATE_LIMIT_WEB_WINDOW_MS=60000
RATE_LIMIT_WEB_MAX=240
RATE_LIMIT_WEB_BAN_THRESHOLD=5
RATE_LIMIT_WEB_BAN_DURATION_MS=600000
RATE_LIMIT_WEB_WHITELIST=
